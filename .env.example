# OptAImum Environment Variables
# Copy to .env and fill in values: cp .env.example .env

# === New Integration Services ===
PAPERCLIP_DB_PASSWORD=changeme_paperclip_db
PINCHTAB_TOKEN=changeme_pinchtab_token
OPENCLAW_GATEWAY_TOKEN=changeme_openclaw_gateway

# Agent Orchestrator (runs natively, not in Docker)
OPENCLAW_HOOKS_TOKEN=changeme_hooks_token

# === OpenClaw Gateway ===
OPENCLAW_STATE_DIR=~/.openclaw
OPENCLAW_WORKSPACE_DIR=~/.openclaw/workspace

# === Notion CRM ===
NOTION_API_KEY=

# === Lead Enrichment ===
HUNTER_API_KEY=
APIFY_TOKEN=

# === Search & Research ===
BRAVE_API_KEY=

# === Email Outreach ===
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=

# === Database (Neon PostgreSQL) ===
PGHOST=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require

# === Messaging ===
TELEGRAM_BOT_TOKEN=
